{
  "manifest_version": 3,
  "name": "TabPeek",
  "version": "1.0.0",
  "description": "Let your local AI tools safely peek at your active browser tab.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}